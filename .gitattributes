# Git LFS Configuration for Large Virtual Machine Files
# This file configures git-lfs to track large binary files

# Virtual Machine Exports (OVA/OVF)
*.ova filter=lfs diff=lfs merge=lfs -text
*.ovf filter=lfs diff=lfs merge=lfs -text
*.vmdk filter=lfs diff=lfs merge=lfs -text
*.vmx filter=lfs diff=lfs merge=lfs -text

# Compressed Virtual Machine Archives
*.tar.gz filter=lfs diff=lfs merge=lfs -text
*.tar.bz2 filter=lfs diff=lfs merge=lfs -text
*.zip filter=lfs diff=lfs merge=lfs -text

# ISO Files (bootable images)
*.iso filter=lfs diff=lfs merge=lfs -text

# Vagrant Box Files
*.box filter=lfs diff=lfs merge=lfs -text

# Large Binary Files
*.bin filter=lfs diff=lfs merge=lfs -text
*.img filter=lfs diff=lfs merge=lfs -text
*.raw filter=lfs diff=lfs merge=lfs -text

# Checksums remain in Git (for integrity verification)
*.sha256 -filter -diff -merge text
*.sha512 -filter -diff -merge text
*.md5 -filter -diff -merge text
