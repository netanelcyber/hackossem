# -*- mode: ruby -*-
# Privilege Escalation in AD (Hard)

Vagrant.configure("2") do |config|
  config.vm.box = "ubuntu/jammy64"
  config.vm.hostname = "ad-lab-4"

  config.vm.network "private_network", ip: "192.168.56.52"
  config.vm.network "forwarded_port", guest: 5000, host: 2052

  config.vm.provider "virtualbox" do |vb|
    vb.name = "VulnLab-ad-lab-4"
    vb.memory = 2048
    vb.cpus = 2
  end

  config.vm.synced_folder "../", "/home/vagrant/hackossem"

  config.vm.provision "shell", inline: <<-SHELL
    set -e
    apt-get update
    apt-get install -y python3 python3-pip python3-venv git
    cd /home/vagrant/hackossem
    python3 -m venv venv
    source venv/bin/activate
    pip install --upgrade pip
    pip install -r requirements.txt
  SHELL
end
