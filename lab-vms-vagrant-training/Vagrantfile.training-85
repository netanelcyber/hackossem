# -*- mode: ruby -*-
# Lab 85: Golden Ticket & Domain Takeover - Advanced (Easy)
# Base: golden-ticket | Scenario: Advanced | Difficulty: Easy

Vagrant.configure("2") do |config|
  config.vm.box = "ubuntu/jammy64"
  config.vm.hostname = "training-85"

  # Network configuration
  config.vm.network "private_network", ip: "192.168.66.85"
  config.vm.network "forwarded_port", guest: 5000, host: 5090

  # VirtualBox configuration
  config.vm.provider "virtualbox" do |vb|
    vb.name = "VulnLab-Training-training-85"
    vb.memory = 2048
    vb.cpus = 2
  end

  # Sync project directory
  config.vm.synced_folder "../../", "/home/vagrant/hackossem"

  # Provisioning
  config.vm.provision "shell", inline: <<-SHELL
    set -e
    apt-get update
    apt-get install -y python3 python3-pip python3-venv git curl

    cd /home/vagrant/hackossem
    python3 -m venv venv
    source venv/bin/activate

    pip install --upgrade pip
    pip install -r requirements.txt

    # Set training mode environment variable
    export TRAINING_LAB="training-85"
    export LAB_SCENARIO="Advanced"
    export LAB_DIFFICULTY="Easy"
  SHELL
end
