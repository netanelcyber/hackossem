# -*- mode: ruby -*-
# Lab 33: LDAP Enumeration & Exploitation - Custom (Medium)
# Base: ldap-enum | Scenario: Custom | Difficulty: Medium

Vagrant.configure("2") do |config|
  config.vm.box = "ubuntu/jammy64"
  config.vm.hostname = "training-33"

  # Network configuration
  config.vm.network "private_network", ip: "192.168.60.33"
  config.vm.network "forwarded_port", guest: 5000, host: 5038

  # VirtualBox configuration
  config.vm.provider "virtualbox" do |vb|
    vb.name = "VulnLab-Training-training-33"
    vb.memory = 2048
    vb.cpus = 2
  end

  # Sync project directory
  config.vm.synced_folder "../../", "/home/vagrant/hackossem"

  # Provisioning
  config.vm.provision "shell", inline: <<-SHELL
    set -e
    apt-get update
    apt-get install -y python3 python3-pip python3-venv git curl

    cd /home/vagrant/hackossem
    python3 -m venv venv
    source venv/bin/activate

    pip install --upgrade pip
    pip install -r requirements.txt

    # Set training mode environment variable
    export TRAINING_LAB="training-33"
    export LAB_SCENARIO="Custom"
    export LAB_DIFFICULTY="Medium"
  SHELL
end
