# -*- mode: ruby -*-
# Lab 102: Golden Ticket & Domain Takeover - Extreme (Hard)
# Base: golden-ticket | Scenario: Extreme | Difficulty: Hard

Vagrant.configure("2") do |config|
  config.vm.box = "ubuntu/jammy64"
  config.vm.hostname = "training-102"

  # Network configuration
  config.vm.network "private_network", ip: "192.168.68.102"
  config.vm.network "forwarded_port", guest: 5000, host: 5107

  # VirtualBox configuration
  config.vm.provider "virtualbox" do |vb|
    vb.name = "VulnLab-Training-training-102"
    vb.memory = 2048
    vb.cpus = 2
  end

  # Sync project directory
  config.vm.synced_folder "../../", "/home/vagrant/hackossem"

  # Provisioning
  config.vm.provision "shell", inline: <<-SHELL
    set -e
    apt-get update
    apt-get install -y python3 python3-pip python3-venv git curl

    cd /home/vagrant/hackossem
    python3 -m venv venv
    source venv/bin/activate

    pip install --upgrade pip
    pip install -r requirements.txt

    # Set training mode environment variable
    export TRAINING_LAB="training-102"
    export LAB_SCENARIO="Extreme"
    export LAB_DIFFICULTY="Hard"
  SHELL
end
